<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BattleCity.Data</RootNamespace>
    <AssemblyName>BattleCity.Data</AssemblyName>
    <!-- architecture.md §5: loaders and records for data/ JSON. Godot-free so the data tests run in plain dotnet test. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Duel/Duel.Core.csproj" />
  </ItemGroup>
</Project>
